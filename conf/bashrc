# only source this file during interactive shells
if [[ $- != *i* ]] ; then
	return
fi


# always use gentoo's PS1
if (( EUID == 0 )); then
	PS1='\[\e[01;31m\]\h\[\e[01;34m\] \w \$\[\e[00m\] '
else
	PS1='\[\e[01;32m\]\u@\h\[\e[01;34m\] \w \$\[\e[00m\] '
fi


# include ~/bin in path
export PATH=$PATH:$HOME/bin

# file browsing aliases
alias ll="ls -lh"
alias la="ls -lah"

# enable spell checking, job checking, and better tab completion
shopt -s cdspell
shopt -s checkjobs
shopt -s complete_fullquote
shopt -s dirspell

# enable tab completion using sudo, not sure if this works
complete -cf sudo


# checks disk space in the current supplied directory
# defaults to cwd if no argument is provided
duf() {

    local opts
    local target

    if [[ -n $1 ]]; then
        target="$1"
    else
        target="."
    fi

    if [[ -n $2 ]]; then
        local opts="-n$2"
    fi

    du -hxa --max-depth=1 "$target" | sort -hr | head $opts
}


# root doesn't need to do some things
if (( EUID == 0 )); then
	return
fi


# ye old url stripping dig wrapper
digthis() {
    dig $(echo "$@" | sed -e 's|http://||g' -e 's|https://||g' | cut -d/ -f1 | cut -d: -f1)
}
