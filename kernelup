#!/bin/bash

# default options
menuconfig=false
oldconfig=false

# parse options
for arg in "$@"; do
    case $arg in
        -m|--menuconfig)
            menuconfig=true
        ;;
    esac
done

# # if there's a saved config for the currently selected kernel, use it
# current_kernel_config="/etc/kernels/kernel-config-$(eselect kernel list | grep \* | awk '{print $2}' | sed 's/linux-//g')-x86_64"
