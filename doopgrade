#!/bin/bash

# default options
sync=true
auto=false

# parse options
for arg in "$@"; do
    case $arg in
        -n|--no-sync)
                sync=false
            ;;
        -a|--auto)
                auto=true
            ;;
    esac
done

# if sync is selected (default), sync portage or die trying
if $sync; then
    if ! /usr/bin/sudo /usr/bin/eix-sync; then
        echo "Failed to sync." >&2 
        exit 1
    fi
fi

# update the system, prompting to accept changes by default
if ! $auto; then
    /usr/bin/sudo /usr/bin/emerge -auND --with-bdeps y --keep-going y world; update_exit=$?
else
    /usr/bin/sudo /usr/bin/emerge -uND --with-bdeps y --keep-going y world; update_exit=$?
fi

# or die trying
if [[ update_exit -ne 0 ]]; then
    echo "Emerge failed." >&2
    exit 2
fi

# rebuild preserved libraries or die trying
if ! /usr/bin/sudo /usr/bin/emerge @preserved-rebuild; then 
    echo "Preserved-rebuild failed." >&2
    exit 3
fi

# clean up unused packages
if ! $auto; then
    /usr/bin/sudo /usr/bin/emerge -ac; package_clean_exit=$?
else
    /usr/bin/sudo /usr/bin/emerge -c; package_clean_exit=$?
fi

# rebuild shared library depenencies and update configs
/usr/bin/sudo /usr/bin/eclean-dist -d; dist_clean_exit=$?
/usr/bin/sudo /usr/sbin/dispatch-conf; conf_exit=$?

# update flatpak applications
if $auto; then 
    /usr/bin/flatpak update -y; flatpak_exit=$?
else
    /usr/bin/flatpak update; flatpak_exit=$?
fi

# check status codes and report failure
[[ package_clean_exit -ne 0 ]] && echo "Failed to clean packages."
[[ dist_clean_exit -ne 0 ]]    && echo "Failed to clean distfiles."
[[ conf_exit -ne 0 ]]          && echo "Failed to update configurations."
[[ flatpak_exit -ne 0 ]]       && echo "Flatpak failed to update."